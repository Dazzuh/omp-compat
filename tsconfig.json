{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "scripts"
  ],
  "exclude": [
    "test/drill"
  ]
}
